generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String    @default("")
  contentHtml     String    @default("")
  coverImage      String?
  coverCredit     String?
  language        String    @default("en") // primary language of the piece
  translationHtml String?                  // optional translation body (e.g. Hindi/English)
  translationLang String?                  // language code of the translation
  status          String    @default("draft") // draft | published
  featured        Boolean   @default(false)
  seoTitle        String?
  seoDescription  String?
  readingMinutes  Int       @default(1)
  views           Int       @default(0)   // real, tracked views
  likes           Int       @default(0)   // real, tracked likes
  viewsBoost      Int       @default(0)   // added to the PUBLIC view count only
  likesBoost      Int       @default(0)   // added to the PUBLIC like count only
  notifiedAt      DateTime?                 // when subscribers were emailed about this article
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tags            Tag[]     @relation("ArticleTags")
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[] @relation("ArticleTags")
}

// Reader comments on articles. Requires Google sign-in (authorEmail captured
// from the session); posts appear immediately. Admin can delete.
model Comment {
  id          String   @id @default(cuid())
  articleSlug String
  authorName  String
  authorEmail String
  authorImage String   @default("")
  body        String
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([articleSlug])
}

model Subscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  firstName   String   @default("")
  status      String   @default("active") // active | unsubscribed
  unsubToken  String   @unique @default(cuid())
  source      String   @default("website")
  createdAt   DateTime @default(now())
}

// Private, admin-uploaded contacts for birthday / promotional emails
model Contact {
  id          String   @id @default(cuid())
  email       String
  firstName   String   @default("")
  lastName    String   @default("")
  birthday    DateTime?
  anniversary DateTime?
  notes       String   @default("")
  createdAt   DateTime @default(now())

  @@unique([email])
}

model Newsletter {
  id           String    @id @default(cuid())
  type         String    @default("recap") // recap | general | promo | birthday
  subject      String    @default("")
  previewText  String    @default("")
  contentHtml  String    @default("")
  dataJson     String?   // structured payload (e.g. top 10 recap cards)
  status       String    @default("draft") // draft | pending_approval | approved | sending | sent | failed
  audience     String    @default("subscribers") // subscribers | contacts
  scheduledFor DateTime?
  sentAt       DateTime?
  recipientCount Int     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Appointment {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String   @default("")
  purpose        String   @default("")
  mode           String   @default("meet") // meet | zoom | physical
  requestedStart DateTime
  requestedEnd   DateTime
  status         String   @default("pending") // pending | accepted | rejected | cancelled
  meetingLink    String?
  location       String?
  calendarEventId String?
  cancelToken    String   @unique @default(cuid())
  adminNotes     String   @default("")
  createdAt      DateTime @default(now())
}

// Hidden easter egg: visitors can request a personalized birthday / anniversary
// greeting from Audarya. Delivered manually from the admin dashboard.
model GreetingRequest {
  id         String   @id @default(cuid())
  requesterName  String
  requesterEmail String
  occasion   String   @default("birthday") // birthday | anniversary
  forName    String   @default("")
  onDate     DateTime?
  message    String   @default("")
  status     String   @default("pending") // pending | sent | dismissed
  createdAt  DateTime @default(now())
}

// Availability windows the admin publishes for the public booker. `kind`
// distinguishes online vs in-person; `city` is shown for in-person windows so
// visitors know where Audarya currently is. Times are IST-naive labels.
model Availability {
  id        String   @id @default(cuid())
  kind      String   @default("online") // online | offline
  city      String   @default("")       // shown for offline windows
  dayOfWeek Int       @default(1)         // 0=Sun … 6=Sat
  startTime String   @default("10:00")
  endTime   String   @default("18:00")
  timezone  String   @default("Asia/Kolkata")
  note      String   @default("")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ReadingItem {
  id        String   @id @default(cuid())
  title     String
  author    String   @default("")
  link      String   @default("")
  note      String   @default("")
  category  String   @default("reading") // reading | watching | now
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Flexible key/value store for editable site content (About, Now intro, socials...)
model Setting {
  key   String @id
  value String @default("")
}

// Quotes for the hidden "Who said it?" game. `mine` marks Audarya's own lines;
// the rest are famous quotes. Rounds are built from these (1 of hers + 2 others).
model Quote {
  id        String   @id @default(cuid())
  text      String
  author    String   @default("")   // shown for famous quotes; blank for hers
  mine      Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Dashboard access. The owner (ADMIN_EMAIL) is always allowed; additional
// members (e.g. secretaries) are invited by email and can be revoked.
model TeamMember {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  role      String   @default("member") // owner | member
  status    String   @default("active") // active | revoked
  invitedBy String   @default("")
  createdAt DateTime @default(now())
}

// Addresses blocked from all mailings; they also can't rejoin the list.
model EmailBlacklist {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String   @default("")
  createdAt DateTime @default(now())
}

// A unique website visitor, identified by a first-party id stored in the
// browser. Used for new-vs-repeat and unique-visitor analytics.
model Visitor {
  id           String   @id // client-generated id (stored in localStorage)
  firstSeen    DateTime @default(now())
  lastSeen     DateTime @default(now())
  sessionCount Int      @default(1)
  pageviews    PageView[]

  @@index([firstSeen])
}

// A single page view on the public site. Sessions are grouped by sessionId so
// we can derive session counts and average session duration. `source` buckets
// traffic (organic search / direct / social / referral / internal).
model PageView {
  id           String   @id @default(cuid())
  visitorId    String
  sessionId    String
  path         String   @default("/")
  referrerHost String   @default("")
  source       String   @default("direct") // organic | direct | social | referral | internal
  device       String   @default("desktop") // mobile | tablet | desktop
  isNewVisitor Boolean  @default(false)
  createdAt    DateTime @default(now())

  visitor      Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([sessionId])
  @@index([visitorId])
}

// System log of major actions (article published, contact added, appointment
// accepted, newsletter sent…). Not UI clicks. Exported monthly to Google Drive.
model ActivityLog {
  id        String   @id @default(cuid())
  action    String                    // e.g. "article.published"
  detail    String   @default("")     // human-readable summary
  actor     String   @default("")     // admin email when known
  createdAt DateTime @default(now())

  @@index([createdAt])
}
