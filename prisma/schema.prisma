generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String    @default("")
  contentHtml     String    @default("")
  coverImage      String?
  coverCredit     String?
  language        String    @default("en") // primary language of the piece
  translationHtml String?                  // optional translation body (e.g. Hindi/English)
  translationLang String?                  // language code of the translation
  status          String    @default("draft") // draft | published
  featured        Boolean   @default(false)
  seoTitle        String?
  seoDescription  String?
  readingMinutes  Int       @default(1)
  views           Int       @default(0)
  notifiedAt      DateTime?                 // when subscribers were emailed about this article
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tags            Tag[]     @relation("ArticleTags")
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[] @relation("ArticleTags")
}

// Reader comments on articles. Requires Google sign-in (authorEmail captured
// from the session); posts appear immediately. Admin can delete.
model Comment {
  id          String   @id @default(cuid())
  articleSlug String
  authorName  String
  authorEmail String
  authorImage String   @default("")
  body        String
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([articleSlug])
}

model Subscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  firstName   String   @default("")
  status      String   @default("active") // active | unsubscribed
  unsubToken  String   @unique @default(cuid())
  source      String   @default("website")
  createdAt   DateTime @default(now())
}

// Private, admin-uploaded contacts for birthday / promotional emails
model Contact {
  id        String   @id @default(cuid())
  email     String
  firstName String   @default("")
  lastName  String   @default("")
  birthday  DateTime?
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@unique([email])
}

model Newsletter {
  id           String    @id @default(cuid())
  type         String    @default("recap") // recap | general | promo | birthday
  subject      String    @default("")
  previewText  String    @default("")
  contentHtml  String    @default("")
  dataJson     String?   // structured payload (e.g. top 10 recap cards)
  status       String    @default("draft") // draft | pending_approval | approved | sending | sent | failed
  audience     String    @default("subscribers") // subscribers | contacts
  scheduledFor DateTime?
  sentAt       DateTime?
  recipientCount Int     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Appointment {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String   @default("")
  purpose        String   @default("")
  mode           String   @default("meet") // meet | zoom | physical
  requestedStart DateTime
  requestedEnd   DateTime
  status         String   @default("pending") // pending | accepted | rejected | cancelled
  meetingLink    String?
  location       String?
  calendarEventId String?
  cancelToken    String   @unique @default(cuid())
  adminNotes     String   @default("")
  createdAt      DateTime @default(now())
}

// Hidden easter egg: visitors can request a personalized birthday / anniversary
// greeting from Audarya. Delivered manually from the admin dashboard.
model GreetingRequest {
  id         String   @id @default(cuid())
  requesterName  String
  requesterEmail String
  occasion   String   @default("birthday") // birthday | anniversary
  forName    String   @default("")
  onDate     DateTime?
  message    String   @default("")
  status     String   @default("pending") // pending | sent | dismissed
  createdAt  DateTime @default(now())
}

// Availability windows the admin publishes for the public booker. `kind`
// distinguishes online vs in-person; `city` is shown for in-person windows so
// visitors know where Audarya currently is. Times are IST-naive labels.
model Availability {
  id        String   @id @default(cuid())
  kind      String   @default("online") // online | offline
  city      String   @default("")       // shown for offline windows
  dayOfWeek Int       @default(1)         // 0=Sun … 6=Sat
  startTime String   @default("10:00")
  endTime   String   @default("18:00")
  timezone  String   @default("Asia/Kolkata")
  note      String   @default("")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ReadingItem {
  id        String   @id @default(cuid())
  title     String
  author    String   @default("")
  link      String   @default("")
  note      String   @default("")
  category  String   @default("reading") // reading | watching | now
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Flexible key/value store for editable site content (About, Now intro, socials...)
model Setting {
  key   String @id
  value String @default("")
}
