# --- Core ---
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="byAudarya"
# Serve the admin console on a dedicated subdomain (hidden from the public site).
# Leave empty in local dev to keep the console at /admin on the same host.
NEXT_PUBLIC_STUDIO_HOST=""
# All scheduling/timestamps use IST (Asia/Kolkata)
TZ="Asia/Kolkata"

# --- Auth (NextAuth + Google / GSuite sign-in) ---
# Only this email may access /admin
ADMIN_EMAIL="audarya@yourdomain.com"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- OpenAI (writing assistant + weekly news curation) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# --- Email via Google Workspace / Gmail SMTP ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="audarya@yourdomain.com"
SMTP_PASS="app-password-from-google"
EMAIL_FROM="Audarya Gupta <audarya@yourdomain.com>"

# --- Google Calendar (appointments) ---
# Uses the same Google OAuth app; refresh token for the admin account
GOOGLE_CALENDAR_ID="primary"
GOOGLE_REFRESH_TOKEN=""

# --- Zoom (optional; for zoom-mode appointments) ---
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# --- News sources for weekly recap (optional; falls back to model knowledge) ---
NEWS_API_KEY=""

# --- Cron protection ---
CRON_SECRET="generate-with: openssl rand -base64 32"

# --- CAPTCHA on the appointment form (optional) ---
# Cloudflare Turnstile keys (https://dash.cloudflare.com/?to=/:account/turnstile).
# If unset, a built-in math-challenge CAPTCHA is used instead.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
