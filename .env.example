# --- Core ---
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="byAudarya"
# Serve the admin console on a dedicated subdomain (hidden from the public site).
# Leave empty in local dev to keep the console at /admin on the same host.
NEXT_PUBLIC_STUDIO_HOST=""
# The main public domain. Pre-launch it shows a teaser until you "Go live" from
# the console; other hosts (preview / *.fly.dev) always show the full site.
# Leave empty to disable the teaser gate entirely.
NEXT_PUBLIC_PRIMARY_HOST=""
# All scheduling/timestamps use IST (Asia/Kolkata)
TZ="Asia/Kolkata"

# --- Auth (NextAuth + Google / GSuite sign-in) ---
# Only this email may access /admin
ADMIN_EMAIL="audarya@byaudarya.com"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- OpenAI (writing assistant + weekly news curation) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# --- Email via Google Workspace / Gmail SMTP ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
# Authenticate SMTP as the primary mailbox that sends transactional email.
SMTP_USER="mail@byaudarya.com"
SMTP_PASS="app-password-from-google"
# Default "from" for site/transactional email.
EMAIL_FROM="Audarya Gupta <mail@byaudarya.com>"
# "from" for personal greeting/birthday email. Must be a verified
# "Send mail as" alias on the SMTP_USER account to actually send as it.
GREETINGS_FROM="Audarya Gupta <audarya@byaudarya.com>"

# --- Google Calendar (appointments) ---
# Uses the same Google OAuth app; refresh token for the admin account
GOOGLE_CALENDAR_ID="primary"
GOOGLE_REFRESH_TOKEN=""

# --- Zoom (optional; for zoom-mode appointments) ---
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# --- News sources for weekly recap (optional; falls back to model knowledge) ---
NEWS_API_KEY=""

# --- Cron protection ---
CRON_SECRET="generate-with: openssl rand -base64 32"

# --- CAPTCHA on public forms (appointments/contact) — optional ---
# Preferred: Google reCAPTCHA v2 ("I'm not a robot"). Create free keys at
# https://www.google.com/recaptcha/admin (reCAPTCHA v2 → "I'm not a robot"
# Checkbox), add www.byaudarya.com as a domain. These are read at runtime, so
# no rebuild is needed — set them as Fly secrets.
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
# Alternative: Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile).
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# If none are set, a built-in math-challenge CAPTCHA is used instead.
